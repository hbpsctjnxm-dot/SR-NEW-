<script>
  // --- Toggle UI visibility ---
  const hub = document.getElementById('srHub');
  const toggleBtn = document.getElementById('toggleBtn');

  toggleBtn.addEventListener('click', () => {
    hub.classList.toggle('hidden');
    toggleBtn.textContent = hub.classList.contains('hidden') ? '[ SHOW HUB ]' : '[ SR HUB ]';
  });

  // --- Tabs ---
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
    });
  });

  // --- Toggle rows ---
  function toggleRow(el) {
    el.classList.toggle('enabled');
  }

  // --- UI Scale ---
  function updateScale(val) {
    const scale = (val / 100).toFixed(2);
    document.getElementById('scaleVal').textContent = scale;
    hub.style.transform = hub.classList.contains('hidden')
      ? `translateX(-50%) scale(0.95)`
      : `scale(${scale})`;
    hub.style.transformOrigin = 'top center';
    hub.style.left = '50%';
    hub.style.marginLeft = '-210px';
  }

  // Override hidden class transform to incorporate scale
  const origToggle = hub.classList.toggle.bind(hub.classList);

  // --- Dragging ---
  let isDragging = false, startX, startY, startLeft, startTop;

  const titleBar = document.getElementById('titleBar');

  titleBar.addEventListener('mousedown', e => {
    if (e.target.classList.contains('ctrl-dot')) return;
    isDragging = true;
    const rect = hub.getBoundingClientRect();
    startX = e.clientX;
    startY = e.clientY;
    startLeft = rect.left;
    startTop = rect.top;

    // Remove centering transforms so we can use left/top freely
    hub.style.transform = 'none';
    hub.style.left = startLeft + 'px';
    hub.style.top = startTop + 'px';
    hub.style.marginLeft = '0';

    document.addEventListener('mousemove', onDrag);
    document.addEventListener('mouseup', stopDrag);
  });

  // Touch support
  titleBar.addEventListener('touchstart', e => {
    if (e.target.classList.contains('ctrl-dot')) return;
    const touch = e.touches[0];
    isDragging = true;
    const rect = hub.getBoundingClientRect();
    startX = touch.clientX;
    startY = touch.clientY;
    startLeft = rect.left;
    startTop = rect.top;
    hub.style.transform = 'none';
    hub.style.left = startLeft + 'px';
    hub.style.top = startTop + 'px';
    hub.style.marginLeft = '0';
    document.addEventListener('touchmove', onTouchDrag);
    document.addEventListener('touchend', stopDrag);
  }, { passive: true });

  function onDrag(e) {
    if (!isDragging) return;
    const dx = e.clientX - startX;
    const dy = e.clientY - startY;
    hub.style.left = (startLeft + dx) + 'px';
    hub.style.top = (startTop + dy) + 'px';
  }

  function onTouchDrag(e) {
    if (!isDragging) return;
    const touch = e.touches[0];
    const dx = touch.clientX - startX;
    const dy = touch.clientY - startY;
    hub.style.left = (startLeft + dx) + 'px';
    hub.style.top = (startTop + dy) + 'px';
  }

  function stopDrag() {
    isDragging = false;
    document.removeEventListener('mousemove', onDrag);
    document.removeEventListener('mouseup', stopDrag);
    document.removeEventListener('touchmove', onTouchDrag);
    document.removeEventListener('touchend', stopDrag);
  }

  // --- Keybind rebinding ---
  let listeningKey = null;

  document.querySelectorAll('.keybind-key').forEach(key => {
    key.addEventListener('click', () => {
      if (listeningKey) {
        listeningKey.classList.remove('listening');
        listeningKey.textContent = listeningKey.dataset.prev || listeningKey.textContent;
      }
      if (listeningKey === key) { listeningKey = null; return; }
      listeningKey = key;
      key.dataset.prev = key.textContent;
      key.classList.add('listening');
      key.textContent = '...';
    });
  });

  document.addEventListener('keydown', e => {
    if (!listeningKey) return;
    e.preventDefault();
    const label = e.key === ' ' ? 'SPC'
      : e.key === 'Insert' ? 'INS'
      : e.key === 'Delete' ? 'DEL'
      : e.key.length === 1 ? e.key.toUpperCase()
      : e.key.toUpperCase().slice(0,4);
    listeningKey.textContent = label;
    listeningKey.classList.remove('listening');
    listeningKey = null;
  });
</script>

</body>
</html>
