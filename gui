<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SR Hub - Steal a Brainrot</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;500;600;700&display=swap');

- { margin: 0; padding: 0; box-sizing: border-box; }

body {
background: #0d0d0d;
min-height: 100vh;
font-family: ‘Rajdhani’, sans-serif;
display: flex;
align-items: center;
justify-content: center;
overflow: hidden;
background-image:
repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(255,255,255,0.02) 39px, rgba(255,255,255,0.02) 40px),
repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(255,255,255,0.02) 39px, rgba(255,255,255,0.02) 40px);
}

/* Toggle Button */
#toggleBtn {
position: fixed;
top: 16px;
left: 50%;
transform: translateX(-50%);
background: #1a1a1a;
border: 1px solid #333;
color: #aaa;
font-family: ‘Share Tech Mono’, monospace;
font-size: 11px;
padding: 6px 18px;
cursor: pointer;
border-radius: 3px;
letter-spacing: 2px;
z-index: 9999;
transition: all 0.2s;
text-transform: uppercase;
}
#toggleBtn:hover { background: #222; border-color: #555; color: #eee; }

/* Main GUI Window */
#srHub {
position: fixed;
top: 60px;
left: 50%;
transform: translateX(-50%);
width: 420px;
background: #111;
border: 1px solid #2a2a2a;
border-radius: 6px;
box-shadow: 0 20px 60px rgba(0,0,0,0.8), 0 0 0 1px rgba(255,255,255,0.03) inset;
z-index: 1000;
user-select: none;
transition: opacity 0.2s, transform 0.2s;
min-width: 280px;
}
#srHub.hidden {
opacity: 0;
pointer-events: none;
transform: translateX(-50%) scale(0.95);
}

/* Title Bar */
#titleBar {
display: flex;
align-items: center;
justify-content: space-between;
padding: 10px 14px;
background: #161616;
border-bottom: 1px solid #222;
border-radius: 6px 6px 0 0;
cursor: grab;
}
#titleBar:active { cursor: grabbing; }

.title-left {
display: flex;
align-items: center;
gap: 8px;
}

.logo-icon {
width: 18px;
height: 18px;
background: linear-gradient(135deg, #555 0%, #333 100%);
border-radius: 3px;
display: flex;
align-items: center;
justify-content: center;
font-size: 9px;
color: #ccc;
font-family: ‘Share Tech Mono’, monospace;
font-weight: bold;
flex-shrink: 0;
}

.title-text {
font-family: ‘Share Tech Mono’, monospace;
font-size: 13px;
color: #ccc;
letter-spacing: 3px;
text-transform: uppercase;
}

.title-sub {
font-family: ‘Share Tech Mono’, monospace;
font-size: 9px;
color: #444;
letter-spacing: 2px;
text-transform: uppercase;
margin-top: 1px;
}

.title-controls { display: flex; gap: 6px; align-items: center; }

.ctrl-dot {
width: 10px; height: 10px;
border-radius: 50%;
cursor: pointer;
transition: opacity 0.15s;
}
.ctrl-dot:hover { opacity: 0.7; }
.dot-close { background: #5a5a5a; }
.dot-min { background: #444; }

/* Tab Bar */
#tabBar {
display: flex;
background: #111;
border-bottom: 1px solid #1e1e1e;
overflow-x: auto;
scrollbar-width: none;
}
#tabBar::-webkit-scrollbar { display: none; }

.tab {
flex: 1;
padding: 9px 6px;
text-align: center;
font-family: ‘Rajdhani’, sans-serif;
font-size: 11px;
font-weight: 600;
letter-spacing: 1.5px;
text-transform: uppercase;
color: #444;
cursor: pointer;
border-bottom: 2px solid transparent;
transition: all 0.18s;
white-space: nowrap;
}
.tab:hover { color: #777; background: rgba(255,255,255,0.02); }
.tab.active { color: #bbb; border-bottom-color: #555; background: rgba(255,255,255,0.03); }

/* Tab Content */
.tab-content { display: none; padding: 14px; }
.tab-content.active { display: block; }

/* Section */
.section { margin-bottom: 14px; }
.section-title {
font-family: ‘Share Tech Mono’, monospace;
font-size: 9px;
letter-spacing: 2.5px;
text-transform: uppercase;
color: #3a3a3a;
margin-bottom: 8px;
padding-bottom: 4px;
border-bottom: 1px solid #1a1a1a;
}

/* Toggle Row */
.toggle-row {
display: flex;
align-items: center;
justify-content: space-between;
padding: 9px 10px;
background: #161616;
border-radius: 4px;
margin-bottom: 4px;
border: 1px solid #1c1c1c;
cursor: pointer;
transition: background 0.15s, border-color 0.15s;
}
.toggle-row:hover { background: #1a1a1a; border-color: #252525; }
.toggle-row.enabled { border-color: #2d2d2d; background: #181818; }

.toggle-label {
font-size: 13px;
font-weight: 600;
color: #777;
letter-spacing: 0.5px;
transition: color 0.15s;
}
.toggle-row.enabled .toggle-label { color: #bbb; }

.toggle-badge {
font-family: ‘Share Tech Mono’, monospace;
font-size: 8px;
letter-spacing: 1px;
padding: 2px 6px;
border-radius: 2px;
background: #1d1d1d;
color: #3a3a3a;
margin-left: 6px;
text-transform: uppercase;
}

/* Toggle Switch */
.toggle-switch {
width: 34px;
height: 18px;
background: #1e1e1e;
border-radius: 9px;
position: relative;
transition: background 0.2s;
border: 1px solid #2a2a2a;
flex-shrink: 0;
}
.toggle-row.enabled .toggle-switch {
background: #2e2e2e;
border-color: #404040;
}
.toggle-switch::after {
content: ‘’;
position: absolute;
width: 12px;
height: 12px;
background: #333;
border-radius: 50%;
top: 2px;
left: 2px;
transition: transform 0.2s, background 0.2s;
}
.toggle-row.enabled .toggle-switch::after {
transform: translateX(16px);
background: #888;
}

/* Settings */
.setting-row {
padding: 10px;
background: #161616;
border-radius: 4px;
margin-bottom: 4px;
border: 1px solid #1c1c1c;
}
.setting-label {
font-size: 11px;
font-weight: 600;
color: #555;
letter-spacing: 1.5px;
text-transform: uppercase;
margin-bottom: 10px;
font-family: ‘Share Tech Mono’, monospace;
}
.setting-value {
font-family: ‘Share Tech Mono’, monospace;
font-size: 10px;
color: #666;
float: right;
}

/* Slider */
.slider-wrap { position: relative; padding: 4px 0; }
input[type=range] {
-webkit-appearance: none;
width: 100%;
height: 3px;
background: #222;
border-radius: 2px;
outline: none;
cursor: pointer;
}
input[type=range]::-webkit-slider-thumb {
-webkit-appearance: none;
width: 14px;
height: 14px;
background: #555;
border-radius: 50%;
cursor: pointer;
border: 2px solid #333;
transition: background 0.15s;
}
input[type=range]::-webkit-slider-thumb:hover { background: #777; }

/* Keybind Row */
.keybind-row {
display: flex;
align-items: center;
justify-content: space-between;
padding: 9px 10px;
background: #161616;
border-radius: 4px;
margin-bottom: 4px;
border: 1px solid #1c1c1c;
}
.keybind-name {
font-size: 12px;
font-weight: 600;
color: #666;
letter-spacing: 0.5px;
}
.keybind-key {
font-family: ‘Share Tech Mono’, monospace;
font-size: 10px;
color: #555;
background: #1a1a1a;
border: 1px solid #2a2a2a;
border-radius: 3px;
padding: 3px 8px;
cursor: pointer;
transition: all 0.15s;
min-width: 36px;
text-align: center;
}
.keybind-key:hover { border-color: #444; color: #888; }
.keybind-key.listening {
border-color: #555;
color: #aaa;
animation: pulse 0.8s infinite;
}
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.5} }

/* Status bar */
#statusBar {
display: flex;
align-items: center;
justify-content: space-between;
padding: 7px 14px;
border-top: 1px solid #1a1a1a;
background: #0e0e0e;
border-radius: 0 0 6px 6px;
}
.status-dot {
width: 5px; height: 5px;
background: #3a3a3a;
border-radius: 50%;
display: inline-block;
margin-right: 6px;
animation: blink 2s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
.status-text {
font-family: ‘Share Tech Mono’, monospace;
font-size: 9px;
color: #333;
letter-spacing: 1.5px;
}
.version-tag {
font-family: ‘Share Tech Mono’, monospace;
font-size: 9px;
color: #2a2a2a;
letter-spacing: 1px;
}

/* Scrollable content */
.tab-content { max-height: 340px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: #222 transparent; }
.tab-content::-webkit-scrollbar { width: 3px; }
.tab-content::-webkit-scrollbar-track { background: transparent; }
.tab-content::-webkit-scrollbar-thumb { background: #222; border-radius: 2px; }

/* Resize handle */
#resizeNote {
font-family: ‘Share Tech Mono’, monospace;
font-size: 9px;
color: #2a2a2a;
letter-spacing: 1px;
padding: 4px 14px;
border-top: 1px solid #181818;
text-align: center;
cursor: ew-resize;
}
</style>

</head>
