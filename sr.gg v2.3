-- ===== PUSHER SYSTEM (new auto play) =====
local pusherPart = nil

local function killPusher()
	if pusherPart then pusherPart:Destroy(); pusherPart=nil end
	local char=LP.Character
	if char then
		local old=char:FindFirstChild("PusherPart")
		if old then old:Destroy() end
	end
end

local function makePusher(char)
	killPusher()
	local root=char:WaitForChild("HumanoidRootPart")
	pusherPart=Instance.new("Part")
	pusherPart.Name="PusherPart"
	pusherPart.Size=Vector3.new(0.2,0.2,0.2)
	pusherPart.Transparency=1
	pusherPart.CanCollide=false
	pusherPart.CanTouch=false
	pusherPart.CanQuery=false
	pusherPart.Anchored=false
	pusherPart.Massless=true
	pusherPart.Parent=char
	local w=Instance.new("Weld")
	w.Part0=root; w.Part1=pusherPart
	w.C0=CFrame.new(0,0,-3)
	w.Parent=pusherPart
end

local function pushVel(dir, sp)
	if not pusherPart then return end
	if dir.Magnitude>0 and sp>0 then
		local v=dir.Unit*sp
		pusherPart.Velocity=Vector3.new(v.X,pusherPart.Velocity.Y,v.Z)
	else
		pusherPart.Velocity=Vector3.new(0,pusherPart.Velocity.Y,0)
	end
end

local function stopPush()
	pushVel(Vector3.zero,0)
end

local function moveToPos(tar, sp)
	local c=LP.Character; if not c then return false end
	local rp=c:FindFirstChild("HumanoidRootPart"); if not rp then return false end
	local delta=tar-rp.Position
	local flat=Vector3.new(delta.X,0,delta.Z)
	if flat.Magnitude<0.8 then stopPush(); return true end
	pushVel(flat,sp)
	return false
end

