				autoRightEnabled     = State.autoRightEnabled,
			}
			writefile("SrDuelsConfig.json", HttpService:JSONEncode(cfg))
		end)
	end)
end

local _loadedCfg = nil
local function loadConfigData()
	local hasFile=false; pcall(function() hasFile=isfile("SrDuelsConfig.json") end)
	if not hasFile then return end
	local ok,cfg=pcall(function() return HttpService:JSONDecode(readfile("SrDuelsConfig.json")) end)
	if not ok or type(cfg)~="table" then return end
	_loadedCfg = cfg
	if type(cfg.normalSpeed)=="number"  then State.normalSpeed=cfg.normalSpeed end
	if type(cfg.carrySpeed)=="number"   then State.carrySpeed=cfg.carrySpeed end
	if type(cfg.grabRadius)=="number"   then Steal.StealRadius=cfg.grabRadius end
	if type(cfg.grabDuration)=="number" then Steal.StealDuration=math.clamp(cfg.grabDuration,0.05,2) end
	if type(cfg.floatHeight)=="number"  then State.floatHeight=cfg.floatHeight end
	if type(cfg.autoTPDownY)=="number"  then State.autoTPDownY=cfg.autoTPDownY end
	if cfg.infJump              then State.infJumpEnabled=true end
	if cfg.antiRagdoll          then State.antiRagdollEnabled=true end
	if cfg.fpsBoost             then State.fpsBoostEnabled=true end
	if cfg.brainrotReturnEnabled then State.brainrotReturnEnabled=true end
	if cfg.medusaCounter        then State.medusaCounterEnabled=true end
	if cfg.animEnabled          then State.animEnabled=true end
	if cfg.unwalkEnabled        then State.unwalkEnabled=true end
	if cfg.autoTPDownEnabled    then State.autoTPDownEnabled=true end
	if cfg.stretchRezEnabled    then State.stretchRezEnabled=true end
	if cfg.purpleSkyEnabled     then State.purpleSkyEnabled=true end
	if cfg.floatEnabled         then State.floatEnabled=true end
	if cfg.autoBatToggled       then State.autoBatToggled=true end
	if cfg.autoLeftEnabled      then State.autoLeftEnabled=true end
	if cfg.autoRightEnabled     then State.autoRightEnabled=true end
	if cfg.autoStealEnabled     then Steal.AutoStealEnabled=true end
end

local function applyGuiFromConfig()
	local cfg = _loadedCfg; if not cfg then return end
	-- Number inputs
	if setNormalSpeed and type(cfg.normalSpeed)=="number" then setNormalSpeed(cfg.normalSpeed) end
	if setCarrySpeed  and type(cfg.carrySpeed)=="number"  then setCarrySpeed(cfg.carrySpeed) end
	if setGrabRadius  and type(cfg.grabRadius)=="number"  then setGrabRadius(cfg.grabRadius) end
	if setFloatHeight and type(cfg.floatHeight)=="number" then setFloatHeight(cfg.floatHeight) end
	-- Grab duration box
	pcall(function()
		if boxGrabDuration and type(cfg.grabDuration)=="number" then
			boxGrabDuration.Text = tostring(cfg.grabDuration)
		end
	end)
	-- TP Down Y
	if cfg.autoTPDownY and boxTPDownY then
		pcall(function() boxTPDownY.Text=tostring(cfg.autoTPDownY) end)
	end
	-- Toggles + start functions
	if cfg.autoStealEnabled then
		Steal.AutoStealEnabled=true
		if setInstaGrab then setInstaGrab(true) end
		pcall(startAutoSteal)
	end
	if cfg.infJump              and setInfJump        then setInfJump(true) end
	if cfg.antiRagdoll          and setAntiRag        then setAntiRag(true); pcall(startAntiRagdoll) end
	if cfg.fpsBoost             and setFps            then setFps(true); pcall(applyFPSBoost) end
	if cfg.brainrotReturnEnabled and setBrainrotReturn then setBrainrotReturn(true) end
	if cfg.medusaCounter        and setMedusaCounter  then
		setMedusaCounter(true)
		pcall(function() setupMedusaCounter(LP.Character) end)
	end
	if cfg.animEnabled          and setAnimToggle     then
		setAnimToggle(true)
		task.spawn(function() task.wait(0.5); startAnimToggle() end)
	end
	if cfg.unwalkEnabled        and setUnwalkToggle   then
		setUnwalkToggle(true)
		task.spawn(function() task.wait(0.5); startUnwalk() end)
	end
	if cfg.floatEnabled         and setFloat          then
		setFloat(true)
		task.spawn(startFloat)
	end
	if cfg.autoTPDownEnabled then
		State.autoTPDownEnabled=true
	end
	if cfg.stretchRezEnabled    then pcall(applyStretchRez) end
	if cfg.purpleSkyEnabled     then pcall(applyPurpleSky) end
	if cfg.autoBatToggled       and setAutoBat        then setAutoBat(true); pcall(startBatAimbot) end
	if cfg.autoLeftEnabled      and setAutoLeft       then setAutoLeft(true); pcall(startAutoLeft) end
	if cfg.autoRightEnabled     and setAutoRight      then setAutoRight(true); pcall(startAutoRight) end
end

