local function handleAction(action)
	if action == "AutoLeft" then
		State.autoLeftEnabled = not State.autoLeftEnabled
		if setAutoLeft then setAutoLeft(State.autoLeftEnabled) end
		if State.autoLeftEnabled then startAutoLeft() else stopAutoLeft() end

	elseif action == "AutoRight" then
		State.autoRightEnabled = not State.autoRightEnabled
		if setAutoRight then setAutoRight(State.autoRightEnabled) end
		if State.autoRightEnabled then startAutoRight() else stopAutoRight() end

	elseif action == "AutoPlay" then
		local on = not State.autoPlayEnabled
		if setAutoPlay then setAutoPlay(on) end
		if on then toggleAutoPlay(true) else stopAutoPlay() end

	elseif action == "AutoBat" then
		if State.autoBatToggled then stopBatAimbot() else startBatAimbot() end
		if setAutoBat then setAutoBat(State.autoBatToggled) end

	elseif action == "DropBrainrot" then
		if not State.dropBrainrotActive then
			if setDropBrainrot then setDropBrainrot(true) end
			task.spawn(runDropBrainrot)
		end

	elseif action == "Taunt" then
		task.spawn(sendTaunt)

	elseif action == "AutoSteal" then
		Steal.AutoStealEnabled = not Steal.AutoStealEnabled
		if setInstaGrab then setInstaGrab(Steal.AutoStealEnabled) end
		if Steal.AutoStealEnabled then startAutoSteal() else stopAutoSteal() end

	elseif action == "InfJump" then
		State.infJumpEnabled = not State.infJumpEnabled
		if setInfJump then setInfJump(State.infJumpEnabled) end

	elseif action == "AntiRagdoll" then
		State.antiRagdollEnabled = not State.antiRagdollEnabled
		if setAntiRag then setAntiRag(State.antiRagdollEnabled) end
		if State.antiRagdollEnabled then startAntiRagdoll() else stopAntiRagdoll() end

	elseif action == "BrainrotReturn" then
		State.brainrotReturnEnabled = not State.brainrotReturnEnabled
		if setBrainrotReturn then setBrainrotReturn(State.brainrotReturnEnabled) end
		if State.brainrotReturnEnabled then
			detectBaseSideAsync(function(side)
				State.brainrotReturnSide = (side=="right") and "left" or "right"
			end)
		end

	elseif action == "MedusaCounter" then
		State.medusaCounterEnabled = not State.medusaCounterEnabled
		if setMedusaCounter then setMedusaCounter(State.medusaCounterEnabled) end
		if State.medusaCounterEnabled then setupMedusaCounter(LP.Character) else stopMedusaCounter() end

	elseif action == "Float" then
		State.floatEnabled = not State.floatEnabled
		if setFloat then setFloat(State.floatEnabled) end
		if State.floatEnabled then startFloat() else stopFloat() end

	elseif action == "AutoTPDown" then
		State.autoTPDownEnabled = not State.autoTPDownEnabled

	elseif action == "StretchRez" then
		State.stretchRezEnabled = not State.stretchRezEnabled
		if State.stretchRezEnabled then pcall(applyStretchRez) else pcall(stopStretchRez) end

	elseif action == "PurpleSky" then
		State.purpleSkyEnabled = not State.purpleSkyEnabled
		if State.purpleSkyEnabled then pcall(applyPurpleSky) else pcall(stopPurpleSky) end

	elseif action == "HideGui" then
		State.guiVisible = not State.guiVisible
		local pg = LP:FindFirstChild("PlayerGui")
		local g2 = pg and pg:FindFirstChild("SrDuelsGUI")
		if g2 then g2.Enabled = State.guiVisible end
	end
end
