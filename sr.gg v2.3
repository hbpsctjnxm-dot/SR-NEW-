local function setQALocked(on)
	qaLocked = on
	lockBtn.Text = on and "🔒" or "🔓"
	lockBtn.BackgroundColor3 = on and Color3.fromRGB(60,20,20) or Color3.fromRGB(30,30,30)
	-- Save lock state to config
	pcall(function()
		LP:SetAttribute("SrDuels_QALocked", on)
		LP:SetAttribute("SrDuels_QAX", qaGroup.Position.X.Offset)
		LP:SetAttribute("SrDuels_QAY", qaGroup.Position.Y.Offset)
	end)
end

lockBtn.MouseButton1Click:Connect(function()
	setQALocked(not qaLocked)
end)

-- Restore saved position
pcall(function()
	local savedLocked = LP:GetAttribute("SrDuels_QALocked")
	local savedX      = LP:GetAttribute("SrDuels_QAX")
	local savedY      = LP:GetAttribute("SrDuels_QAY")
	if savedX and savedY then
		qaGroup.Position = UDim2.new(qaGroup.Position.X.Scale, savedX, qaGroup.Position.Y.Scale, savedY)
	end
	if savedLocked then setQALocked(savedLocked) end
end)

-- Draggable with lock check
do
	local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
	qaGroup.InputBegan:Connect(function(inp)
		if qaLocked then return end
		if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
			-- Don't drag when tapping QA buttons themselves
			local objs = LP:FindFirstChild("PlayerGui") and LP.PlayerGui:GetGuiObjectsAtPosition(inp.Position.X, inp.Position.Y) or {}
			for _, obj in pairs(objs) do
				if obj ~= qaGroup and obj:IsDescendantOf(qaGroup) and obj:IsA("TextButton") then
					return
				end
			end
			dragging = true
			dragStart = inp.Position
			startPos  = qaGroup.Position
			inp.Changed:Connect(function()
				if inp.UserInputState == Enum.UserInputState.End then
					dragging = false
					-- Auto-save position on release
					pcall(function()
						LP:SetAttribute("SrDuels_QAX", qaGroup.Position.X.Offset)
						LP:SetAttribute("SrDuels_QAY", qaGroup.Position.Y.Offset)
					end)
				end
			end)
		end
	end)
	qaGroup.InputChanged:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseMovement then
			dragInput = inp
		end
	end)
	UIS.InputChanged:Connect(function(inp)
		if inp == dragInput and dragging and not qaLocked then
			local dx = inp.Position.X - dragStart.X
			local dy = inp.Position.Y - dragStart.Y
			qaGroup.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + dx,
				startPos.Y.Scale, startPos.Y.Offset + dy
			)
		end
	end)
end

