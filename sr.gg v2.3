UIS.InputBegan:Connect(function(input, processed)
	if processed then return end
	local k = input.KeyCode

	if input.UserInputType == Enum.UserInputType.Keyboard then
		for action, key in pairs(Keys) do
			if k == key then handleAction(action); break end
		end

	elseif input.UserInputType == Enum.UserInputType.Gamepad1
		or input.UserInputType == Enum.UserInputType.Gamepad2 then
		for action, key in pairs(CtrlKeys) do
			if k == key then handleAction(action); break end
		end
	end
end)

