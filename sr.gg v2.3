local function startAutoPlayMovement()
	if Conns.autoPlay then Conns.autoPlay:Disconnect() end
	State.autoPlayPhase=1; State.autoPlayWaiting=false
	local isLeft = State.autoPlaySide~="right"
	-- Waypoints from new script
	local p1  = isLeft and Vector3.new(-476.48,-6.28,92.73)  or Vector3.new(-476.16,-6.52,25.62)
	local p2  = isLeft and Vector3.new(-483.12,-4.95,94.80)  or Vector3.new(-483.04,-5.09,23.14)
	local p3  = isLeft and Vector3.new(-475.92,-6.99,25.36)  or Vector3.new(-475.99,-6.99,96.00)
	-- Show waypoint ESP
	showWaypointESP({p1, p2, p3})
	local normalSpd = State.normalSpeed or 56.5
	local carrySpd  = State.carrySpeed  or 27.5
	local freezeT   = 0.1
	Conns.autoPlay=RunService.RenderStepped:Connect(function()
		if not State.autoPlayEnabled then return end
		local c=LP.Character; if not c then return end
		local rp=c:FindFirstChild("HumanoidRootPart")
		local hum2=c:FindFirstChildOfClass("Humanoid")
		if not rp or not hum2 then return end
		hum2.WalkSpeed=0; hum2.AutoRotate=false
		local phase=State.autoPlayPhase
		if phase==1 then
			if moveToPos(Vector3.new(p1.X,rp.Position.Y,p1.Z),normalSpd) then
				State.autoPlayPhase=2
			end
		elseif phase==2 then
			if moveToPos(Vector3.new(p2.X,rp.Position.Y,p2.Z),normalSpd) then
				stopPush()
				State.autoPlayPhase=0
				if Conns.autoPlay then Conns.autoPlay:Disconnect(); Conns.autoPlay=nil end
				task.spawn(function()
					task.wait(freezeT)
					if not State.autoPlayEnabled then return end
					State.autoPlayPhase=3
					Conns.autoPlay=RunService.RenderStepped:Connect(function()
						if not State.autoPlayEnabled then return end
						local c2=LP.Character; if not c2 then return end
						local rp2=c2:FindFirstChild("HumanoidRootPart")
						local hum3=c2:FindFirstChildOfClass("Humanoid")
						if not rp2 or not hum3 then return end
						hum3.WalkSpeed=0; hum3.AutoRotate=false
						local ph=State.autoPlayPhase
						if ph==3 then
							if moveToPos(Vector3.new(p1.X,rp2.Position.Y,p1.Z),carrySpd) then
								State.autoPlayPhase=4
							end
						elseif ph==4 then
							if moveToPos(Vector3.new(p3.X,rp2.Position.Y,p3.Z),carrySpd) then
								stopAutoPlay()
							end
						end
					end)
				end)
			end
		end
	end)
end

toggleAutoPlay = function(on)
	if not on then stopAutoPlay(); return end
	State.autoPlayEnabled = true
	local char=LP.Character
	if char then makePusher(char) end
	local function beginMovement(side)
		State.autoPlaySide = (side=="right") and "left" or "right"
		if not State.autoPlayEnabled then return end
		startAutoPlayMovement()
	end
	if State.detectedBaseSide then
		task.spawn(function() beginMovement(State.detectedBaseSide) end)
	else
		detectBaseSideAsync(function(side)
			if State.autoPlayEnabled then beginMovement(side) end
		end)
	end
end

local function findMedusa()
	local char=LP.Character; if not char then return nil end
	for _,tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then local tn=tool.Name:lower(); if tn:find("medusa") or tn:find("head") or tn:find("stone") then return tool end end
	end
	local bp=LP:FindFirstChild("Backpack")
	if bp then for _,tool in ipairs(bp:GetChildren()) do
		if tool:IsA("Tool") then local tn=tool.Name:lower(); if tn:find("medusa") or tn:find("head") or tn:find("stone") then return tool end end
	end end
	return nil
end
local function useMedusaCounter()
	if State.medusaDebounce then return end
	if tick()-State.medusaLastUsed<MEDUSA_COOLDOWN then return end
	local char=LP.Character; if not char then return end
	State.medusaDebounce=true
	local med=findMedusa(); if not med then State.medusaDebounce=false; return end
	if med.Parent~=char then local hum2=char:FindFirstChildOfClass("Humanoid"); if hum2 then hum2:EquipTool(med) end end
	pcall(function() med:Activate() end)
	State.medusaLastUsed=tick(); State.medusaDebounce=false
end
local function onAnchorChanged(part)
	return part:GetPropertyChangedSignal("Anchored"):Connect(function()
		if part.Anchored and part.Transparency==1 then useMedusaCounter() end
	end)
end
setupMedusaCounter=function(char)
	stopMedusaCounter(); if not char then return end
	for _,part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then table.insert(Conns.anchor,onAnchorChanged(part)) end
	end
	table.insert(Conns.anchor,char.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") then table.insert(Conns.anchor,onAnchorChanged(part)) end
	end))
end
