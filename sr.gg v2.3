-- ===== QA GROUP: MOVABLE + LOCKABLE =====
local qaLocked = false
local qaPos = {x=0, y=0} -- saved offset position

-- Lock button (small padlock icon in corner of qaGroup)
local lockBtn = Instance.new("TextButton", qaGroup)
lockBtn.Size     = UDim2.new(0, math.floor(20*GS), 0, math.floor(20*GS))
