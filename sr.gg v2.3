local function isTargetValid(targetChar)
	if not targetChar then return false end
	local hum2 = targetChar:FindFirstChildOfClass("Humanoid")
	local hrp2 = targetChar:FindFirstChild("HumanoidRootPart")
	local ff   = targetChar:FindFirstChildOfClass("ForceField")
	return hum2 and hrp2 and hum2.Health > 0 and not ff
end

local function getBestTarget(myHRP)
	if lockedTarget and isTargetValid(lockedTarget) then
		return lockedTarget:FindFirstChild("HumanoidRootPart"), lockedTarget
	end
	local shortestDist, newChar, newHRP = math.huge, nil, nil
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and isTargetValid(p.Character) then
			local tr = p.Character:FindFirstChild("HumanoidRootPart")
			local d  = (tr.Position - myHRP.Position).Magnitude
			if d < shortestDist then shortestDist=d; newHRP=tr; newChar=p.Character end
		end
	end
	lockedTarget = newChar
	return newHRP, newChar
end

local function findBatTool()
	local char = LP.Character; if not char then return nil end
	local bp   = LP:FindFirstChild("Backpack")
	local SlapList = {"Bat","Slap","Iron Slap","Gold Slap","Diamond Slap","Emerald Slap","Ruby Slap","Dark Matter Slap","Flame Slap","Nuclear Slap","Galaxy Slap","Glitched Slap"}
	for _, ch in ipairs(char:GetChildren()) do
		if ch:IsA("Tool") and ch.Name:lower():find("bat") then return ch end
	end
	if bp then for _, ch in ipairs(bp:GetChildren()) do
		if ch:IsA("Tool") and ch.Name:lower():find("bat") then return ch end
	end end
	for _, name in ipairs(SlapList) do
		local t = char:FindFirstChild(name) or (bp and bp:FindFirstChild(name))
		if t then return t end
	end
end

local function startBatAimbot()
	if aimbotConnection then return end
	local char = LP.Character; if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum2 = char:FindFirstChildOfClass("Humanoid")
	if not root or not hum2 then return end
	hum2.AutoRotate = false
	local att   = root:FindFirstChild("AimbotAttachment") or Instance.new("Attachment", root)
	att.Name    = "AimbotAttachment"
	local align = root:FindFirstChild("AimbotAlign") or Instance.new("AlignOrientation", root)
	align.Name  = "AimbotAlign"
	align.Mode  = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0   = att
	align.MaxTorque     = math.huge
	align.Responsiveness= 200
	State.autoBatToggled = true
	aimbotConnection = RunService.Heartbeat:Connect(function()
		if not State.autoBatToggled then return end
		local c2 = LP.Character; if not c2 then return end
		local currentHRP = c2:FindFirstChild("HumanoidRootPart"); if not currentHRP then return end
		local currentHum = c2:FindFirstChildOfClass("Humanoid")
		local now = tick()
		local bat = findBatTool()
		if bat and bat.Parent ~= c2 then pcall(function() currentHum:EquipTool(bat) end) end
		local targetHRP, targetChar = getBestTarget(currentHRP)
		if targetHRP and targetChar then
			aimbotHighlight.Adornee = targetChar
			local vel  = targetHRP.AssemblyLinearVelocity
			local spd  = vel.Magnitude
			local pTime= math.clamp(spd/150, 0.05, 0.2)
			local pred = targetHRP.Position + vel*pTime
			local dir  = pred - currentHRP.Position
			local dist = dir.Magnitude
			local standPos = dist>0 and (pred - dir.Unit*MELEE_OFFSET) or pred
			align.CFrame = CFrame.lookAt(currentHRP.Position, pred)
			local movDir = standPos - currentHRP.Position
			local movDist= movDir.Magnitude
			if movDist > 1 then
				currentHRP.AssemblyLinearVelocity = movDir.Unit * AIMBOT_SPEED
			else
				currentHRP.AssemblyLinearVelocity = vel
			end
			if movDist <= BAT_ENGAGE_RANGE then
				if bat and bat.Parent==c2 and (now-lastBatSwing)>=BAT_SWING_COOLDOWN then
					lastBatSwing = now
					pcall(function() bat:Activate() end)
				end
			end
		else
			lockedTarget = nil
			currentHRP.AssemblyLinearVelocity = Vector3.new(0,0,0)
			aimbotHighlight.Adornee = nil
		end
	end)
end

local function stopBatAimbot()
	State.autoBatToggled = false
	if aimbotConnection then aimbotConnection:Disconnect(); aimbotConnection=nil end
	local c2   = LP.Character
	local root = c2 and c2:FindFirstChild("HumanoidRootPart")
	local hum2 = c2 and c2:FindFirstChildOfClass("Humanoid")
	if root then
		local att2 = root:FindFirstChild("AimbotAttachment"); if att2 then att2:Destroy() end
		local al2  = root:FindFirstChild("AimbotAlign");      if al2  then al2:Destroy()  end
		root.AssemblyLinearVelocity = Vector3.new(0,0,0)
	end
	if hum2 then hum2.AutoRotate = true end
	lockedTarget = nil
	aimbotHighlight.Adornee = nil
end

RunService.Heartbeat:Connect(function()
	if not State.brainrotReturnEnabled or State.brainrotReturnCooldown then return end
	local char=LP.Character; if not char then return end
	local hum2=char:FindFirstChildOfClass("Humanoid"); if not hum2 then return end
	local cur=hum2.Health; local wasHit=cur<State.lastKnownHealth-5
	local st=hum2:GetState()
	local isRag=(st==Enum.HumanoidStateType.Physics or st==Enum.HumanoidStateType.Ragdoll or st==Enum.HumanoidStateType.FallingDown)
	State.lastKnownHealth=cur
	if not (wasHit or isRag) then return end
	if State.brainrotReturnSide=="left" then
		doReturnTeleport(POS.RETURN_L)
	elseif State.brainrotReturnSide=="right" then
		doReturnTeleport(POS.RETURN_R)
	elseif not State._sideDetecting then
		State._sideDetecting = true
		detectBaseSideAsync(function(s)
			State.brainrotReturnSide = (s == "right") and "left" or "right"
			State._sideDetecting = false
			doReturnTeleport(State.brainrotReturnSide == "left" and POS.RETURN_L or POS.RETURN_R)
		end)
	end
end)

